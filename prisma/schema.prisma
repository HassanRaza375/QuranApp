// Phase 17 (Account & Sync). The server database: Aiven PostgreSQL through Prisma 7 (docs/phases/phase-17-plan.md, section e).
// The connection URL is not here: it is in prisma.config.ts (for the CLI) and read from DATABASE_URL at request time (server/utils/db.ts).
// Migrations are additive; a destructive one needs its own approval (brief, section 13).

generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma" // gitignored; `prisma generate` runs in postinstall
}

datasource db {
  provider = "postgresql"
}

// One generic store for every synced record; the server never queries by content. Payloads are validated per namespace
// (app/lib/sync/, from 17C). The link to the user (onDelete: Cascade) is added in 17B together with Better Auth's User table.
model SyncRecord {
  userId    String
  namespace String // allowlisted, e.g. "library.item"
  recordKey String // e.g. "ayah:2:255", "singleton"
  payload   Json? // null when deleted
  schemaVer Int       @default(1)
  revision  BigInt // from SyncCursor: rises per user
  updatedAt DateTime  @default(now()) @updatedAt // server time, never the client's
  deletedAt DateTime? // tombstone
  bytes     Int // payload size, for the per-user cap
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, namespace, recordKey])
  @@index([userId, revision])
}

// One row per user: the revision counter (bumped inside the push transaction, so two devices' pushes are ordered) and the bytes stored.
model SyncCursor {
  userId   String @id
  revision BigInt @default(0)
  bytes    Int    @default(0)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---- Better Auth (17B). Models and field names are the library's own (its CLI writes the same); the additional fields are ours. ----

model User {
  id             String   @id
  name           String
  email          String   @unique
  emailVerified  Boolean  @default(false)
  image          String? // never filled from Google: the provider maps no image (server/utils/authConfig.ts, tests/authConfig.test.ts)
  role           String   @default("user") // "user" or "superadmin"; set only by scripts/make-super-admin.mjs, never by a request (input: false)
  avatarPublicId String? // 17F: the Cloudinary public id of the user’s own photo
  avatarVersion  Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  sessions    Session[]
  accounts    Account[]
  syncRecords SyncRecord[]
  syncCursor  SyncCursor?
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // a scrypt hash, written by Better Auth
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

// storage: "database" (the default memory store does not suit serverless)
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}
